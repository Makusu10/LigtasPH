# --- Core Flask / DB / admin (required) ---
# Generate a strong secret locally: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="YOUR_LONG_RANDOM_SECRET_KEY"
# FLASK_ENV: development | production | testing
FLASK_ENV="development"
# DATABASE_URL: defaults to instance/ligtas.sqlite when unset
DATABASE_URL=""
# Admin seed/login (dev defaults admin/admin123 — set non-default values in production)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# GEMINI_API_KEY: Reserved for Sprint 2 AI — not used in Sprint 1.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENWEATHER_API_KEY: Required for fetching real-time weather data (optional — fallback is Open-Meteo).
OPENWEATHER_API_KEY="YOUR_OPENWEATHER_API_KEY"

# OPEN-METEO: Free, no key required. Global forecast fallback when OpenWeather is rate-limited/offline.
# Docs: https://open-meteo.com/ - backend calls https://api.open-meteo.com/v1/forecast directly.

# AIR QUALITY: Open-Meteo Air Quality (primary, no key, PH) — https://air-quality-api.open-meteo.com
# Fallback: OpenWeather Air Pollution (https://api.openweathermap.org/data/2.5/air_pollution) reuses OPENWEATHER_API_KEY.
# No extra key needed. Units: PM2.5 µg/m³ (DENR DAO 2020-14), US AQI numeric labeled separately.

# MAPBOX_TOKEN: Public token (pk.*) for the 2D/3D map — get one free at https://account.mapbox.com
# Restrict it to your app URL in the Mapbox dashboard. Never use a secret (sk.*) token here.
# When empty/unset, map pages fall back to free OpenStreetMap tiles.
MAPBOX_TOKEN="YOUR_MAPBOX_PUBLIC_TOKEN"

# FIRMS_MAP_KEY: NASA FIRMS active-fires key (free at https://firms.modaps.eosdis.nasa.gov/api/).
# Backend reads this env var only — never commit the real key. Without it, /api/fires returns 503.
FIRMS_MAP_KEY="YOUR_FIRMS_MAP_KEY"
