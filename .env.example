# GEMINI_API_KEY: Reserved for Sprint 2 AI — not used in Sprint 1.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENWEATHER_API_KEY: Required for fetching real-time weather data (optional — fallback is Open-Meteo).
OPENWEATHER_API_KEY="YOUR_OPENWEATHER_API_KEY"

# OPEN-METEO: Free, no key required. Global forecast fallback when OpenWeather is rate-limited/offline.
# Docs: https://open-meteo.com/ - backend calls https://api.open-meteo.com/v1/forecast directly.

# AIR QUALITY: Open-Meteo Air Quality (primary, no key, PH) — https://air-quality-api.open-meteo.com
# Fallback: OpenWeather Air Pollution (https://api.openweathermap.org/data/2.5/air_pollution) reuses OPENWEATHER_API_KEY.
# No extra key needed. Units: PM2.5 µg/m³ (DENR DAO 2020-14), US AQI numeric labeled separately.
