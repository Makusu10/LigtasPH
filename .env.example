# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENWEATHER_API_KEY: Required for fetching real-time weather data.
OPENWEATHER_API_KEY="YOUR_OPENWEATHER_API_KEY"

# OPEN-METEO: Free, no key required. Global forecast fallback when OpenWeather is rate-limited/offline.
# Docs: https://open-meteo.com/ - backend calls https://api.open-meteo.com/v1/forecast directly.

# API.WEATHER.GOV (NOAA): Free, no key required. Supplemental alerts/hazard feed.
# Docs: https://www.weather.gov/documentation/services-web-api - backend calls https://api.weather.gov/alerts as optional tertiary source.
